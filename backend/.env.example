DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_chief
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
SECRET_KEY=change-this-to-a-random-secret-key
GMAIL_CREDENTIALS_FILE=credentials/gmail.json

# App password gate. Leave empty to disable login. Any plaintext password is
# accepted and hashed at startup; you can also paste a "pbkdf2$..." hash here.
AUTH_PASSWORD=

# Org-scoped tracked Classroom course IDs (comma-separated). Empty = track all.
CLASSROOM_COURSE_IDS=

# Business-configurable defaults (env-overridable)
DEFAULT_SCHEDULE_TIME=09:00
DEFAULT_SCHEDULE_DURATION_MINUTES=60
DEFAULT_EXAM_DURATION_MINUTES=180
DEFAULT_WORK_HOURS=9:00-18:00
EMAIL_RETENTION_DAYS=90
EMAIL_SENSITIVITY=PERSONAL
EMERGENCY_CODE_TTL_HOURS=24
VAPID_CLAIMS_EMAIL=aichief@localhost

# Microsoft Teams / Outlook Calendar (device code flow, public client)
# Register an app at https://entra.microsoft.com → App registrations
# Enable "Allow public client flows", add Calendars.Read (delegated) + offline_access
# For personal Microsoft accounts use tenant "consumers"; for work/school use your tenant ID
MS_CLIENT_ID=
MS_TENANT_ID=consumers
