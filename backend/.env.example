# --- Runtime environment -----------------------------------------------------
# "development" (default) keeps the local conveniences below.
# "production" ENFORCES the secret policy in app/core/config.py: the process
# refuses to start unless SECRET_KEY, INGEST_API_KEY and AUTH_PASSWORD are
# explicitly set and strong, unless DATABASE_URL does not carry a local
# development password, and unless WHATSAPP_PROVIDER is either "none" or fully
# configured. See docker-compose.prod.yml.
ENVIRONMENT=development

# --- Database ---------------------------------------------------------------
# The password below is a DEVELOPMENT-ONLY convenience for a Postgres running
# on your own machine. It is not a production secret: with ENVIRONMENT=production
# the backend refuses to start while DATABASE_URL uses this password.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_chief
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Signs session tokens and encrypts stored Google OAuth credentials.
#   development: leave as-is - a strong random key is generated on first boot
#                and persisted to the gitignored 0600 file .secret_key.
#   production : REQUIRED, min 32 chars, and must not be a placeholder or a
#                repeated fragment. Generate one with:
#                  python -c "import secrets; print(secrets.token_urlsafe(48))"
#                Changing it later invalidates every issued token and makes
#                existing encrypted OAuth credentials undecryptable.
SECRET_KEY=change-this-to-a-random-secret-key
# Server-to-server key for the /api/integrations/* endpoints (n8n -> backend).
#   development: leave empty - a strong random key is generated on first boot
#                and persisted to the gitignored 0600 file .ingest_key.
#   production : REQUIRED, min 32 chars. The value must also be given to n8n.
INGEST_API_KEY=
GMAIL_CREDENTIALS_FILE=credentials/gmail.json

# --- Google OAuth (per-user Gmail / Calendar / Classroom sync) ---
# Create an OAuth 2.0 "Web application" client at
# https://console.cloud.google.com/apis/credentials
#   * Authorized redirect URI MUST be:
#     http://localhost:8000/api/integrations/google/callback
#   * Authorized JavaScript origins: http://localhost:3000
#   * Enable the Gmail API, Google Calendar API and Google Classroom API in
#     "Enabled APIs & services".
# Each app user then connects their own Google account from Settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTO_PROVISION=false
# Frontend origin for OAuth callback redirects.
FRONTEND_URL=http://localhost:3000

# App password gate. Leave empty to disable login (DEVELOPMENT ONLY - with
# ENVIRONMENT=production an empty AUTH_PASSWORD stops the process from
# starting, because no gate means an open API).
# Any plaintext password is accepted and hashed at startup; you can also paste a
# "pbkdf2$..." hash here. Production requires at least 12 characters and
# rejects well-known values.
AUTH_PASSWORD=

# One-time operator authorization for creating the FIRST account, which becomes
# the owner. Outside production this is ignored and first-owner registration
# stays open, so a fresh checkout provisions itself with no configuration.
# With ENVIRONMENT=production the first user is created ONLY when the request
# presents this value in the X-Bootstrap-Token header; if it is unset, first
# owner creation is REFUSED - an incomplete production config fails closed, it
# never falls open. There is no default token anywhere in the code, the
# comparison is constant time, and the value is never logged or returned.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Single use: the server records in app_config that the owner has been created,
# so this cannot be replayed and cannot be re-armed later - not after a restart
# and not even if the owner row is deleted. Remove it from the environment once
# the owner exists.
BOOTSTRAP_TOKEN=

# Secure attribute for the OAuth state cookie. Production always sets it
# (HttpOnly + SameSite=Lax + Secure are not negotiable there). Set this to
# false ONLY for a plain-HTTP local development server; unset defaults to
# Secure and logs a warning rather than assuming the deployment is HTTP-safe.
# Leave this in backend/.env - it is deliberately NOT forwarded through
# docker-compose, because an empty compose value is parsed as a boolean rather
# than as "unset".
OAUTH_COOKIE_SECURE=

# Comma-separated proxy IPs whose X-Forwarded-For header is trusted for login
# rate limiting. EMPTY (default) trusts no proxy, so a direct client cannot
# spoof its IP. Set ONLY when the app sits behind a reverse proxy, to that
# proxy's address (e.g. TRUSTED_PROXY_IPS=127.0.0.1).
TRUSTED_PROXY_IPS=

# Org-scoped tracked Classroom course IDs (comma-separated). Empty = track all.
CLASSROOM_COURSE_IDS=

# --- CHARUSAT e-Governance attendance (read-only, per-user) ---
# The portal login is CAPTCHA-protected, so the connector NEVER logs in for the
# student: they sign in themselves and either import the saved attendance page
# or paste their own browser session cookie (stored encrypted). EGOV_ALLOWED_HOSTS
# pins outbound reads to the university host (SSRF guard); an empty value blocks
# all reads. Refreshes are user-initiated only - there is no polling.
EGOV_BASE_URL=https://support.charusat.edu.in/Egov/
EGOV_ALLOWED_HOSTS=support.charusat.edu.in
EGOV_REQUEST_TIMEOUT=20
EGOV_MAX_RETRIES=2
EGOV_RETRY_BASE_DELAY=0.5
EGOV_STALE_AFTER_HOURS=24

# --- PostgreSQL connection / pool (production) ---
# Safe DB operation recovery (recoverable connection failures with bounded
# exponential-backoff retry and pool disposal).
DB_OPERATION_MAX_RETRIES=3
DB_OPERATION_RETRY_BASE_DELAY=0.5
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# --- Ollama reliability / backpressure ---
# Maximum number of simultaneous Ollama requests (bounded concurrency).
OLLAMA_MAX_CONCURRENT_REQUESTS=2
# Retry temporary failures with exponential backoff.
OLLAMA_MAX_RETRIES=3
OLLAMA_RETRY_BASE_DELAY=1.0
OLLAMA_REQUEST_TIMEOUT=120.0
# Circuit breaker to stop hammering a failing Ollama.
OLLAMA_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
OLLAMA_CIRCUIT_BREAKER_RESET_SECONDS=60
OLLAMA_CIRCUIT_BREAKER_HALF_OPEN_MAX=1

# --- AI processing worker queue ---
AI_WORKER_THREADS=2
AI_QUEUE_MAX_SIZE=100

# --- Request/resource bounds (NF-6) ---
# List endpoints clamp the caller-supplied `limit` to this ceiling so a single
# request cannot materialise an unbounded result set.
API_MAX_PAGE_SIZE=200
# Document uploads larger than this many megabytes are rejected with HTTP 413
# before the body is buffered.
MAX_UPLOAD_MB=25

# --- Background sync loop intervals (seconds) ---
SYNC_GMAIL_INTERVAL_SECONDS=600
SYNC_CLASSROOM_INTERVAL_SECONDS=1800

# --- Internal service hostnames (Docker portability) ---
# Backend URL as seen by other containers. Replace host.docker.internal on
# Linux/production with the Docker service name / reachable URL.
BACKEND_INTERNAL_URL=http://backend:8000
POSTGRES_HOST=

# Business-configurable defaults (env-overridable)
DEFAULT_SCHEDULE_TIME=09:00
DEFAULT_SCHEDULE_DURATION_MINUTES=60
DEFAULT_EXAM_DURATION_MINUTES=180
DEFAULT_WORK_HOURS=9:00-18:00
EMAIL_RETENTION_DAYS=90
EMAIL_SENSITIVITY=PERSONAL
EMERGENCY_CODE_TTL_HOURS=24
VAPID_CLAIMS_EMAIL=aichief@localhost

# Microsoft Teams / Outlook Calendar (device code flow, public client)
# Register an app at https://entra.microsoft.com → App registrations
# Enable "Allow public client flows", add Calendars.Read (delegated) + offline_access
# For personal Microsoft accounts use tenant "consumers"; for work/school use your tenant ID
MS_CLIENT_ID=
MS_TENANT_ID=consumers

# --- WhatsApp (optional: none | twilio | twilio_sandbox | meta | whatsapp_cloud_api) ---
# Selecting a provider REQUIRES that provider's full credential set - the
# backend refuses to start on a half-configured provider so the webhook can
# never degrade into an unverified one.
# Provider webhooks are verified before any message is accepted:
#   * twilio  -> X-Twilio-Signature (HMAC-SHA1 over URL + form params, using TWILIO_AUTH_TOKEN)
#   * meta    -> X-Hub-Signature-256 (HMAC-SHA256 over the raw body, using META_WA_APP_SECRET)
# META_WA_VERIFY_TOKEN is required for the GET webhook verification handshake
# and must be a strong, unique value. Leave WHATSAPP_PROVIDER unset (or "none")
# to disable WhatsApp entirely.
WHATSAPP_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your own Twilio sender number. There is NO default: a real phone number must
# never be committed to the repository.
TWILIO_WHATSAPP_FROM=whatsapp:+YOUR_NUMBER_HERE
# Optional outbound recipient used by manual sends. Never commit a real number.
WHATSAPP_SEND_TO=
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_APP_SECRET=
META_WA_VERIFY_TOKEN=
