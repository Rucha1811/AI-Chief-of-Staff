    },
    {
      "id": "MuSe3Yz4Ab5Cd6Ef",
      "name": "Select Accounts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        120
      ],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "// Normalize either an array response or one item per account. Emit one item per trusted account so the sync node runs once per user.\nconst payload = $input.all().flatMap((item) =>\n  Array.isArray(item.json) ? item.json : [item.json],\n);\nreturn payload\n  .filter((account) => account && account.account_id)\n  .map((account) => ({\n    json: {\n      account_id: account.account_id,\n      user_id: account.user_id,\n      email: account.email,\n    },\n  }));\n"
      }
    },
    {
      "id": "MuSy7Gh8Ij9Kl0Mn",
      "name": "Sync Account",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        0,
        360
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AI_CHIEF_BACKEND_URL || 'http://backend:8000' }}/api/integrations/agent/sync",
        "sendBody": true,
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "responseFormat": "json",
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ account_id: $json.account_id, limit: 50, auto_process: true }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "uPlTEMjHPTL0IZ1j",
          "name": "AI Chief Ingest API"
        }
      }
    },
    {
      "id": "MuRp1Op2Qr3St4Uv",
      "name": "Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        600
      ],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst runs = $input.all().map((i) => i.json);\nreturn [{\n  json: {\n    runs,\n    total_added: runs.reduce((s, r) => s + (r.added || 0), 0),\n    at: new Date().toISOString(),\n  },\n}];\n"
      }
    }
  ],
