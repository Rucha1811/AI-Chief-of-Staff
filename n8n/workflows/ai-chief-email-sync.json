      "name": "List Accounts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        0,
        -120
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.AI_CHIEF_BACKEND_URL || 'http://backend:8000' }}/api/integrations/agent/accounts",
        "sendBody": false,
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
