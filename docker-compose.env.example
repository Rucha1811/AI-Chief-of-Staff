# Copy to `.env` (gitignored) and fill in real values. The compose files read
# these. NEVER commit real secrets.

# --- Runtime environment ---
# "development" keeps the local conveniences (generated SECRET_KEY /
# INGEST_API_KEY, optional AUTH_PASSWORD).
# "production" enforces the secret policy in backend/app/core/config.py: the
# backend refuses to start unless every secret below is explicitly set and
# strong. Use it together with docker-compose.prod.yml, which makes these
# variables mandatory so docker compose aborts instead of defaulting.
ENVIRONMENT=development

# --- PostgreSQL ---
# The "postgres" password below is a DEVELOPMENT-ONLY default for a local
# database. It is not a production secret, but with ENVIRONMENT=production the
# backend refuses to start while DATABASE_URL carries it.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_chief
POSTGRES_HOST=postgres
POSTGRES_HOST_PORT=5434

# --- Backend ---
# Internal backend URL as seen by other containers (n8n on the shared network).
BACKEND_INTERNAL_URL=http://backend:8000
# Frontend-facing backend URL. In development this becomes the frontend's
# build-time NEXT_PUBLIC_API_URL (NEXT_PUBLIC_* is inlined by `next build`,
# so it is a build argument, not a runtime environment variable).
FRONTEND_API_URL=http://localhost:8000
# Frontend URL used for OAuth redirects back into the browser.
FRONTEND_URL=http://localhost:3000

# --- Production-required origins (Phase D3) ---
# The BASE docker-compose.yml deliberately does not forward these two: in
# development the backend's built-in defaults are correct and changing them
# here would do nothing until the base file forwards them. They exist so that
# the copy used with docker-compose.prod.yml has somewhere real to put the
# production values - that overlay makes both mandatory (`:?`), and
# backend/app/core/config.py refuses to boot if either still points at
# localhost/127.0.0.1. OAUTH_REDIRECT_URI must include the path
# /api/integrations/google/callback and be registered with Google.
OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
# Bare origins (scheme://host[:port]), comma-separated: no path, no query.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# --- Google OAuth (per-user Gmail / Calendar / Classroom sync) ---
# Create an OAuth 2.0 "Web application" client at
# https://console.cloud.google.com/apis/credentials
#   * Authorized redirect URI MUST be:
#     http://localhost:8000/api/integrations/google/callback
#   * Authorized JavaScript origins: http://localhost:3000
# Each app user connects their own Google account from Settings → Connect Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Ollama ---
# macOS/Docker Desktop: keep the host loopback.
# Linux/production: set to the reachable Ollama URL, or use the optional
# Ollama sidecar and set to http://ollama:11434.
# NOTE: with docker-compose.prod.yml this becomes MANDATORY, because
# host.docker.internal only resolves on Docker Desktop and a silent default
# would just make the AI features time out on a Linux host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# --- DB pool ---
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# --- n8n ---
AI_CHIEF_BACKEND_URL=http://backend:8000

# --- Backend secrets ---
# Leave SECRET_KEY and INGEST_API_KEY EMPTY in development: the backend then
# generates a strong random value once and persists it to a gitignored 0600
# file (backend/.secret_key, backend/.ingest_key) so restarts keep it stable.
# For the n8n ingest key, read the generated value from backend/.ingest_key.
#
# With ENVIRONMENT=production both are REQUIRED (min 32 chars, no placeholders):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The same INGEST_API_KEY must be configured in n8n's "AI Chief Ingest API"
# credential.
SECRET_KEY=
INGEST_API_KEY=
# App password gate. Empty disables login (development only). Production
# requires at least 12 characters, or a "pbkdf2$..." hash.
AUTH_PASSWORD=

# One-time operator authorization for creating the FIRST account (the owner).
# docker-compose.prod.yml forwards it as optional-and-empty-by-default: unset
# means first-owner creation is REFUSED in production (fail closed), which
# keeps every already-provisioned deployment restartable without adding a new
# mandatory variable. To provision the first owner:
#   1. BOOTSTRAP_TOKEN=$(python -c "import secrets;print(secrets.token_urlsafe(32))") \
#      docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#   2. curl -X POST .../api/auth/register -H "X-Bootstrap-Token: $BOOTSTRAP_TOKEN" ...
#   3. remove BOOTSTRAP_TOKEN and redeploy - it is single use anyway.
# It is single use: the server records that the owner exists, so the value
# cannot be replayed, not even after the owner row is deleted.
BOOTSTRAP_TOKEN=

# --- WhatsApp (optional: none | twilio | twilio_sandbox | meta | whatsapp_cloud_api) ---
# Selecting a provider requires that provider's full credential set; the
# backend refuses to start on a half-configured one. META_WA_VERIFY_TOKEN is
# required for the GET webhook verification handshake.
WHATSAPP_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your own sender number. There is no default - never commit a real number.
TWILIO_WHATSAPP_FROM=whatsapp:+YOUR_NUMBER_HERE
WHATSAPP_SEND_TO=
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_APP_SECRET=
META_WA_VERIFY_TOKEN=

# --- Production resource ceilings (Phase D5, docker-compose.prod.yml only) ---
# Sensible defaults are set in the overlay; these are here so a deployment
# can raise or lower them without editing a tracked file. Ollama is
# deliberately NOT limited - a loaded model is measured in GiB, and an
# arbitrary ceiling would OOM-kill inference mid-request.
POSTGRES_CPUS_LIMIT=1.0
POSTGRES_MEM_LIMIT=1g
BACKEND_CPUS_LIMIT=1.5
BACKEND_MEM_LIMIT=1536m
FRONTEND_CPUS_LIMIT=0.5
FRONTEND_MEM_LIMIT=512m

# --- Optional: reverse proxy addresses (production) ---
# Empty (the default) trusts NO proxy, so X-Forwarded-For cannot be spoofed
# by a client. Set it only once a reverse proxy actually sits in front of the
# backend and its address is known.
TRUSTED_PROXY_IPS=
